#!/bin/bash
#SBATCH --job-name=ospm
#SBATCH -p normal
#SBATCH -A AST23031
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
#SBATCH --time=01:30:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G

set -euo pipefail
module purge
module load python/3.12.11
module load gcc/12.2.0
export JULIA_BINDIR=/scratch/09909/n8lujan99/julia-1.10.10/bin
export PATH="$JULIA_BINDIR:$PATH"
export JULIA_DEPOT_PATH=/scratch/09909/n8lujan99/.julia
export JULIA_PKG_SERVER=""
export JULIA_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
if [[ -z "${OSPM_REPO_ROOT:-}" ]]; then
    echo "[FATAL] OSPM_REPO_ROOT not set"
    exit 1
fi
REPO_ROOT="$OSPM_REPO_ROOT"
cd "$REPO_ROOT"
source .venv/bin/activate
echo "[SLURM] Host: $(hostname)"
echo "[SLURM] Julia: $(julia --version)"
echo "[SLURM] Python: $(python --version)"
echo "[SLURM] Threads: ${JULIA_NUM_THREADS}"
echo "[SLURM] Repo: $REPO_ROOT"
bash utils/start
