#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "[push] Not inside a git repository."
    exit 1
}

cd "$REPO_ROOT"

echo "[push] Repo root: $REPO_ROOT"
echo "[push] Branch: $(git branch --show-current)"
echo

git pull --rebase origin main

git status --short
echo

read -rp "[push] Commit message: " MSG
[[ -z "$MSG" ]] && { echo "Empty commit message"; exit 1; }

git add -A

if git diff --cached --quiet; then
    echo "[push] Nothing to commit."
else
    git commit -m "$MSG"
fi

git push origin main

echo "[push] Done."
