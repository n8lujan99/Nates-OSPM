#!/usr/bin/env bash
set -euo pipefail

# push — developer push (PC only)

HOST="$(hostname)"

if [[ "$HOST" == *login* || "$HOST" == *ls6* || -n "${SLURM_JOB_ID:-}" ]]; then
    echo "[push] Refusing: pushes from cluster environments are not allowed."
    exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)" || {
    echo "[push] Not inside a git repo."
    exit 1
}

cd "$REPO_ROOT"

echo "[push] Repo root: $REPO_ROOT"
echo "[push] Branch: $(git branch --show-current)"
echo

git pull --rebase origin main

git status --short
echo

read -rp "[push] Commit message: " MSG
[[ -z "$MSG" ]] && { echo "Empty message."; exit 1; }

git add -A
git commit -m "$MSG"

git push origin main

echo "[push] Done."
