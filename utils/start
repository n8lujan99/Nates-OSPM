#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WHICH_FILE="$ROOT/which_galaxy"
export OSPM_USE_JULIA=1
export PYJULIA_USE_PYTHONCALL=1
export PYTHONPATH="$ROOT"
export JULIA_DEPOT_PATH="$HOME/.julia"
if command -v julia >/dev/null 2>&1; then
  JULIA_BIN="$(command -v julia)"
elif [ -x "$HOME/julia-1.10.10/bin/julia" ]; then
  JULIA_BIN="$HOME/julia-1.10.10/bin/julia"
  export PATH="$HOME/julia-1.10.10/bin:$PATH"
else
  echo "[START] ERROR: julia not found"
  exit 2
fi
export OSPM_JULIA_EXE="$JULIA_BIN"
(unset LD_LIBRARY_PATH; unset LD_PRELOAD; "$JULIA_BIN" -e 'println("Julia runtime ready")')
GALAXY="$(tr -d '[:space:]' < "$WHICH_FILE")"
echo "[START] Repo root: $ROOT"
echo "[START] Galaxy: $GALAXY"
python3 - <<'PY'
from OSPM.Physics import OSPM_Physics as P
print("[CHECK] USE_JULIA:", P.USE_JULIA)
PY
python3 -m OSPM.Controllers.OSPM_RUN
