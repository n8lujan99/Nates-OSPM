#!/usr/bin/env bash
set -e

export OSPM_USE_JULIA=1

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_DIR="$ROOT_DIR/.venv"
REQ_FILE="$ROOT_DIR/utils/_Setup/requirements.txt"

echo "[setup] OSPM root: $ROOT_DIR"

command -v python3 >/dev/null 2>&1 || { echo "[setup] ERROR: python3 not found"; exit 1; }

if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
fi

source "$VENV_DIR/bin/activate"
pip install --upgrade pip

if command -v julia >/dev/null 2>&1; then
    JULIA_BIN="$(command -v julia)"
elif [ -x "$HOME/julia-1.10.10/bin/julia" ]; then
    JULIA_BIN="$HOME/julia-1.10.10/bin/julia"
    export PATH="$HOME/julia-1.10.10/bin:$PATH"
else
    echo "[setup] ERROR: Julia not found"
    exit 2
fi

export JULIA_DEPOT_PATH="$HOME/.julia"

"$JULIA_BIN" --version

_LD_LIBRARY_PATH_SAVED="${LD_LIBRARY_PATH-}"
_LD_PRELOAD_SAVED="${LD_PRELOAD-}"
(
    unset LD_LIBRARY_PATH
    unset LD_PRELOAD
    "$JULIA_BIN" -e 'println("Julia runtime OK")'
)
export LD_LIBRARY_PATH="$_LD_LIBRARY_PATH_SAVED"
export LD_PRELOAD="$_LD_PRELOAD_SAVED"
python3 - <<EOF || echo "[setup] PyJulia skipped"
from julia.api import Julia
Julia(runtime="$JULIA_BIN", compiled_modules=False)
print("[setup] PyJulia OK")
EOF
python3 - <<EOF
import subprocess, sys
req = ["numpy","scipy","pandas","matplotlib","astropy","torch"]
missing=[p for p in req if __import__(p,fromlist=["*"]) is None]
if missing:
    subprocess.check_call([sys.executable,"-m","pip","install","-r","$REQ_FILE"])
EOF
echo "[setup] Environment ready"
