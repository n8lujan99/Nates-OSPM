#!/usr/bin/env bash
set -e

export OSPM_USE_JULIA=1

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_DIR="$ROOT_DIR/.venv"
REQ_FILE="$ROOT_DIR/utils/_Setup/requirements.txt"

echo "[setup] OSPM root: $ROOT_DIR"

if ! command -v python3 >/dev/null 2>&1; then
    echo "[setup] ERROR: python3 not found"
    exit 1
fi

if [ ! -d "$VENV_DIR" ]; then
    echo "[setup] Creating venv"
    python3 -m venv "$VENV_DIR"
else
    echo "[setup] venv exists"
fi

source "$VENV_DIR/bin/activate"

pip install --upgrade pip

# -------------------------------------------------
# Julia verification (portable)
# -------------------------------------------------

if command -v julia >/dev/null 2>&1; then
    JULIA_BIN="$(command -v julia)"
elif [ -x "$HOME/julia-1.10.10/bin/julia" ]; then
    JULIA_BIN="$HOME/julia-1.10.10/bin/julia"
    export PATH="$HOME/julia-1.10.10/bin:$PATH"
else
    echo "[setup] ERROR: Julia not found"
    exit 2
fi

export JULIA_DEPOT_PATH="$HOME/.julia"
echo "[setup] Julia version:"
"$JULIA_BIN" --version
echo "[setup] Warming up Julia runtime"
unset LD_LIBRARY_PATH
unset LD_PRELOAD
"$JULIA_BIN" -e 'println("Julia runtime OK")'
echo "[setup] Checking PyJulia"
python - <<EOF
from julia.api import Julia
Julia(runtime="$JULIA_BIN", compiled_modules=False)
print("[setup] PyJulia OK")
EOF


# -------------------------------------------------
# Python deps
# -------------------------------------------------
python - <<EOF
import subprocess, sys
required = ["numpy","scipy","pandas","matplotlib","astropy","torch"]
missing = []
for p in required:
    try: __import__(p)
    except ImportError: missing.append(p)
if missing:
    subprocess.check_call([sys.executable,"-m","pip","install","-r","$REQ_FILE"])
EOF

echo "[setup] Environment ready"
